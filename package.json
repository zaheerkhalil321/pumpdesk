{
  "name": "pumpdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "pack": "npx -y repomix",
    "pack:dispatch": "npx -y repomix --include \"src/components/schedule/**,src/app/(app)/schedule/**,src/app/(app)/pumps/**,src/lib/**,src/types/**\"",
    "pack:orders": "npx -y repomix --include \"src/components/orders/**,src/app/(app)/orders/**,src/lib/**\"",
    "pack:crm": "npx -y repomix --include \"src/app/(app)/customers/**,src/app/(app)/contacts/**,src/lib/**\"",
    "ai:verify": "npx tsc --noEmit && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.48.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
