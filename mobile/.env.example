# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* values reach the app.
# mock = demo data on the phone, supabase = the real backend.
EXPO_PUBLIC_API_MODE=mock
# Local Supabase from a phone: use this computer's Wi-Fi address, not 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.0.10:54321
# The anon (public) key from `supabase status`. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: number the sign-in help sheet calls before the company is known (E.164, e.g. +12075550100).
EXPO_PUBLIC_HELP_PHONE=
