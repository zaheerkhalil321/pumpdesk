{
  "expo": {
    "name": "PumpDesk",
    "slug": "pumpdesk-operator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pumpdesk",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pumpdesk.operator",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PumpDesk shares your location with dispatch only while you are on the way to or at a job."
      }
    },
    "android": {
      "package": "com.pumpdesk.operator",
      "adaptiveIcon": {
        "backgroundColor": "#0A2A5A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A2A5A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "PumpDesk uses your photos so you can set a profile picture.",
          "cameraPermission": "PumpDesk uses the camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
