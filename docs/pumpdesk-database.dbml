// PumpDesk database blueprint
// Version: 0.2 (October 2026)
// Purpose: Multi-company concrete pumping operations platform
// Conventions:
// - Every operational table has company_id (tenant). RLS reads company and role live from company_memberships.
// - Instants are timestamptz (stored UTC). Local days are date. Timezones are IANA names (text), never offsets.
// - Money is numeric(12,2); quantities numeric(12,3); yards numeric(10,2). Never float.
// - No hard deletes on core tables: is_active = false.
// - Generated from the schema used for the ERD page; keep the two in sync.

Project PumpDesk {
  database_type: 'PostgreSQL'
  Note: 'Core operational schema for concrete pumping companies.'
}

Enum membership_role {
  owner
  admin
  dispatcher
  office
  operator
  mechanic
  accountant
  read_only
}

Enum membership_status {
  invited
  active
  suspended
}

Enum customer_status {
  lead
  active
  inactive
  blocked
}

Enum project_status {
  planning
  active
  on_hold
  completed
  cancelled
}

Enum equipment_type {
  boom_pump
  line_pump
  trailer_pump
  placing_boom
  service_truck
  support_vehicle
  other
}

Enum equipment_status {
  available
  maintenance
  out_of_service
  retired
}

Enum employee_status {
  active
  inactive
  leave
  terminated
}

Enum time_off_status {
  requested
  approved
  denied
  cancelled
}

Enum inspection_status {
  draft
  passed
  failed
  needs_attention
}

Enum maintenance_status {
  open
  scheduled
  in_progress
  waiting_parts
  completed
  cancelled
}

Enum maintenance_priority {
  low
  normal
  high
  critical
}

Enum job_priority {
  low
  normal
  high
  urgent
}

Enum booking_status {
  pending
  inspection_pending
  confirmed
  turned_in
  reviewed
  cancelled
  no_show
}

Enum dispatch_status {
  unassigned
  assigned
  dispatched
  acknowledged
}

Enum field_status {
  scheduled
  en_route
  on_site
  pumping
  washout
  returning
  done
}

Enum assignment_type {
  primary_operator
  second_operator
  helper
}

Enum reservation_source {
  job
  maintenance
  time_off
  hold
}

Enum note_visibility {
  internal
  operator
  customer
}

Enum file_visibility {
  internal
  customer
}

Enum pricing_model {
  hourly_min
  per_unit
  flat
}

Enum ticket_status {
  draft
  submitted
  approved
  rejected
  invoiced
  void
}

Enum invoice_status {
  draft
  sent
  partially_paid
  paid
  overdue
  void
}

Enum payment_status {
  pending
  succeeded
  failed
  refunded
  void
}

Enum payment_method {
  cash
  check
  ach
  card
  wire
  other
}

Enum contact_channel {
  email
  sms
  off
}

Enum notification_channel {
  email
  sms
  in_app
}

Enum rule_audience {
  customer
  office
}

Enum delivery_status {
  queued
  sent
  delivered
  failed
  skipped_stale
  opted_out
}

Enum doc_type {
  job
  ticket
  invoice
  work_order
}

Enum tag_color {
  amber
  fuchsia
  blue
  teal
  slate
}

// ── Company and team ────────────────────────────────────────────

Table companies {
  id uuid [pk, note: 'gen_random_uuid()']
  legal_name text [not null]
  display_name text [not null]
  slug text [not null, unique]
  timezone text [not null, note: 'IANA name, e.g. \'America/New_York\'. Never an offset']
  currency "char(3)" [not null, note: '\'USD\'']
  phone text
  email text
  website text
  address_line_1 text
  city text
  state text
  postal_code text
  country_code "char(2)" [not null, note: '\'US\'']
  logo_path text [note: 'storage path']
  address_line_2 text [note: 'suite / unit']
  logo_text text [note: 'initials shown when no logo, e.g. \'MC\'']
  tax_id_last4 text [note: 'last 4 digits only']
  is_active boolean [not null, note: 'default true; soft delete']
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'One row per pumping company (the tenant).'
}

Table branches {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  name text [not null]
  code text [not null]
  address_line_1 text
  city text
  state text
  postal_code text
  latitude "numeric(10,7)"
  longitude "numeric(10,7)"
  phone text
  is_hq boolean [not null]
  is_active boolean [not null, note: 'default true; soft delete']
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, code) [unique]
    (company_id, id) [unique, note: 'target of composite tenant FKs']
  }

  Note: 'Yards: Warren HQ, Portland, Bangor.'
}

Table app_users {
  id uuid [pk, note: '= auth.users.id']
  full_name text
  phone text
  avatar_path text
  last_active_at timestamptz
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Profile. id = auth.users.id.'
}

Table company_memberships {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  user_id uuid [not null, ref: > app_users.id]
  role membership_role [not null]
  status membership_status [not null, note: 'suspended = blocked on next request']
  invited_by uuid [ref: > app_users.id]
  joined_at timestamptz
  invited_at timestamptz
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, user_id) [unique]
    (user_id, status)
  }

  Note: 'Who belongs to which company, and their role. Read live by every RLS check.'
}

Table company_settings {
  company_id uuid [pk, ref: > companies.id]
  default_job_minutes integer [not null, note: '240']
  default_minimum_hours "numeric(6,2)" [not null, note: '4.00']
  default_tax_rate "numeric(7,4)" [not null, note: '0.0550 = 5.5%']
  invoice_due_days integer [not null, note: '30']
  remit_to text
  require_ticket_signature boolean [not null]
  default_cancellation_fee "numeric(12,2)"
  require_operator_ticket_approval boolean [not null]
  use_address_on_invoices boolean [not null]
  billing_email text
  accepted_payment_methods text [note: 'e.g. \'ACH, Check, Wire\'']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'One row per company.'
}

Table document_sequences {
  company_id uuid [ref: > companies.id]
  doc_type doc_type
  prefix text [not null]
  next_value bigint [not null]

  indexes {
    (company_id, doc_type) [pk]
  }

  Note: 'Race-free ORD- / TKT- / INV- numbers.'
}

// ── Customers ───────────────────────────────────────────────────

Table customers {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  customer_number text
  business_name text [not null]
  legal_name text
  status customer_status [not null]
  tier text
  phone text
  email text
  billing_address_line_1 text
  billing_city text
  billing_state text
  billing_postal_code text
  payment_terms_days integer
  tax_exempt boolean [not null]
  credit_limit "numeric(12,2)"
  credit_hold boolean [not null]
  requires_po boolean [not null]
  dispatch_note text
  version integer [not null, note: 'optimistic locking']
  customer_type text
  website text
  billing_address_line_2 text
  billing_country_code "char(2)" [not null, note: '\'US\'']
  tax_exempt_number text
  internal_notes text [note: 'office only']
  is_active boolean [not null, note: 'default true; soft delete']
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, id) [unique, note: 'target of composite tenant FKs']
    (company_id, customer_number) [unique, note: 'customer_number stays nullable in V1']
    (company_id, business_name)
  }

  Note: 'Contractor accounts.'
}

Table contacts {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  first_name text [not null]
  last_name text
  job_title text
  email text
  phone text [note: 'E.164, e.g. +12075550110']
  phone_type text
  notes text
  is_active boolean [not null, note: 'default true; soft delete']
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, id) [unique, note: 'target of composite tenant FKs']
  }

  Note: 'People: supers, PMs, billing staff.'
}

Table customer_contact_links {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  customer_id uuid [not null, ref: > customers.id]
  contact_id uuid [not null, ref: > contacts.id]
  roles "text[]" [not null, note: 'e.g. {\'Primary contact\',\'Site contact\'}']
  is_primary boolean [not null]
  receives_job_confirmations boolean [not null]
  receives_invoices boolean [not null, note: 'default invoice recipient']
  created_at timestamptz [not null, note: 'now()']

  indexes {
    (customer_id, contact_id) [unique]
    (company_id, customer_id)
    (company_id, contact_id)
  }

  Note: 'A contact can work for several customers. Composite FKs (company_id, customer_id) -> customers and (company_id, contact_id) -> contacts.'
}

Table contact_notification_prefs {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  contact_id uuid [not null, ref: > contacts.id]
  event_type text [not null, note: 'e.g. \'pump_en_route\'']
  channel contact_channel [not null]
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Per contact: each message by text, email or off.'
}

Table job_sites {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  customer_id uuid [ref: > customers.id]
  name text
  address_line_1 text [not null]
  city text [not null]
  state text [not null]
  postal_code text
  latitude "numeric(10,7)"
  longitude "numeric(10,7)"
  timezone text [note: 'IANA; null = company timezone']
  gate_code text
  access_notes text
  washout_notes text
  hazard_notes text
  address_line_2 text
  country_code "char(2)" [not null, note: '\'US\'']
  setup_notes text
  is_active boolean [not null, note: 'default true; soft delete']
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, customer_id)
  }

  Note: 'Where the pump goes. Composite FK (company_id, customer_id) -> customers.'
}

Table projects {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  customer_id uuid [not null, ref: > customers.id]
  job_site_id uuid [ref: > job_sites.id]
  project_number text
  name text [not null]
  status project_status [not null]
  start_date date
  end_date date
  general_contractor text
  project_manager_contact_id uuid [ref: > contacts.id]
  description text
  internal_notes text
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'A larger job spanning many pours.'
}

Table concrete_suppliers {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  name text [not null]
  phone text
  dispatch_phone text
  email text
  address_line_1 text
  city text
  state text
  postal_code text
  notes text
  is_active boolean [not null, note: 'default true; soft delete']
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Ready-mix plants.'
}

// ── Dispatch ────────────────────────────────────────────────────

Table jobs {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_number text [not null, note: '\'ORD-1525\'']
  customer_id uuid [not null, ref: > customers.id]
  job_site_id uuid [ref: > job_sites.id, note: 'optional: the saved site, when the order uses one']
  site_label text [not null, note: 'the site as typed or picked. A town alone is enough']
  project_id uuid [ref: > projects.id]
  supplier_name text [note: 'plain text until concrete_suppliers is built (Settings > Lists)']
  pour_type text [note: 'plain text until pour_types is built (Settings > Lists)']
  billing_service text [note: 'plain text until rate cards are built']
  job_name text
  scheduled_start timestamptz [not null, note: 'pour start, UTC']
  scheduled_end timestamptz [not null, note: 'may be the next local day']
  arrive_by timestamptz
  timezone text [not null, note: 'IANA, copied from site or company']
  service_date date [not null, note: 'local day of scheduled_start, set by trigger']
  travel_minutes integer [not null]
  prep_minutes integer [not null]
  pump_minutes integer [not null]
  cleanup_minutes integer [not null]
  estimated_yards "numeric(10,2)" [not null]
  min_pump_size text [note: 'e.g. \'34 m\' or \'Line pump\'']
  lines_on_site boolean [not null]
  purchase_order_number text
  collect_on_delivery boolean [not null]
  booking_status booking_status [not null]
  dispatch_status dispatch_status [not null, note: 'derived from assignments by trigger']
  field_status field_status [not null]
  confirmed_at timestamptz
  dispatched_at timestamptz
  cancelled_at timestamptz
  cancellation_reason text
  version integer [not null, note: 'optimistic locking: +1 on every save']
  idempotency_key uuid [unique]
  created_by uuid [ref: > app_users.id]
  updated_by uuid [ref: > app_users.id]
  priority job_priority [not null, note: 'default normal']
  customer_reference text
  mix_type text
  slump text [note: 'e.g. \'5 in\'']
  requested_equipment_type equipment_type
  arrival_window_start timestamptz
  arrival_window_end timestamptz
  site_instructions text [note: 'shown to the operator']
  customer_notes text [note: 'customer-visible details']
  internal_note text
  completed_at timestamptz
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, job_number) [unique]
    (company_id, service_date, scheduled_start)
    (company_id, booking_status, scheduled_start, id)
    (company_id, customer_id, scheduled_start)
  }

  Note: 'The order. Times are UTC instants; service_date is the local day.'
}

Table job_contacts {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, ref: > jobs.id]
  contact_id uuid [not null, ref: > contacts.id]
  role text [not null]
  created_at timestamptz [not null, note: 'now()']

  Note: 'Site contact and other contacts for an order.'
}

Table job_extra_items {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, ref: > jobs.id]
  rate_card_item_id uuid [not null, ref: > rate_card_items.id]
  quantity "numeric(12,3)" [not null]
  created_at timestamptz [not null, note: 'now()']

  Note: 'Extra hose, off-site washout, fuel surcharge.'
}

Table job_equipment_assignments {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, ref: > jobs.id]
  equipment_id uuid [not null, ref: > equipment.id]
  assigned_at timestamptz [not null]
  assigned_by uuid [ref: > app_users.id]
  released_at timestamptz
  notes text

  Note: 'Which pump does the job.'
}

Table job_employee_assignments {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, ref: > jobs.id]
  employee_id uuid [not null, ref: > employees.id]
  assignment_type assignment_type [not null]
  assigned_at timestamptz [not null]
  assigned_by uuid [ref: > app_users.id]
  acknowledged_at timestamptz [note: 'null on every new assignment']
  released_at timestamptz
  notes text

  Note: 'Operator or helper. Acknowledgement belongs to this row.'
}

Table resource_reservations {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  equipment_id uuid [ref: > equipment.id]
  employee_id uuid [ref: > employees.id]
  period tstzrange [not null, note: 'yard departure to yard return, [start, end)']
  source_type reservation_source [not null]
  source_id uuid [not null, note: 'job / work order / time off id']
  is_hard boolean [not null, note: 'pending = soft, confirmed = hard']
  released_at timestamptz [note: 'set on cancel or reassign']
  created_at timestamptz [not null, note: 'now()']

  Note: 'Time blocks for pumps and people. Exclusion constraints forbid overlaps. Constraints: EXCLUDE (company_id =, equipment_id =, period &&) where hard and active, deferrable; EXCLUDE (company_id =, employee_id =, period &&) where hard and active, deferrable.'
}

Table job_status_history {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, ref: > jobs.id]
  dimension text [not null, note: 'booking / dispatch / field']
  old_value text
  new_value text [not null]
  reason text
  changed_by uuid [ref: > app_users.id]
  changed_at timestamptz [not null]

  Note: 'Every status change, written by transition_job.'
}

Table job_notes {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, ref: > jobs.id]
  author_id uuid [ref: > app_users.id]
  visibility note_visibility [not null]
  body text [not null]
  is_pinned boolean [not null]
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Notes with a visibility level.'
}

Table job_files {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, ref: > jobs.id]
  uploaded_by uuid [ref: > app_users.id]
  visibility file_visibility [not null]
  file_name text [not null]
  file_path text [not null]
  mime_type text
  size_bytes bigint
  category text
  caption text
  created_at timestamptz [not null, note: 'now()']

  Note: 'Photos and documents.'
}

// ── Fleet ───────────────────────────────────────────────────────

Table equipment {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  branch_id uuid [ref: > branches.id]
  equipment_number text [not null, note: '\'01\'']
  type equipment_type [not null]
  status equipment_status [not null]
  make text
  model text
  model_year smallint
  vin text
  license_plate text
  boom_length_m "numeric(6,2)" [note: '34.00']
  horizontal_reach_ft "numeric(8,2)"
  vertical_reach_ft "numeric(8,2)"
  engine_hours "numeric(12,2)"
  hourly_rate_override "numeric(12,2)"
  min_hours_override "numeric(6,2)"
  default_operator_id uuid [ref: > employees.id]
  serial_number text
  current_mileage "numeric(12,2)"
  purchase_date date
  in_service_date date
  retired_date date
  next_inspection_due date [note: 'drives the due-soon badge']
  available_again_on date [note: 'maintenance only: counts as available from this day; null = stays in maintenance']
  notes text
  is_active boolean [not null, note: 'default true; soft delete']
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, id) [unique, note: 'target of composite tenant FKs']
    (company_id, equipment_number) [unique]
    (company_id, status)
    (company_id, default_operator_id)
  }

  Note: 'Pumps and trucks. Composite FKs (company_id, branch_id) -> branches and (company_id, default_operator_id) -> employees. No version column: last write wins in V1.'
}

Table equipment_documents {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  equipment_id uuid [not null, ref: > equipment.id]
  document_type text [not null]
  title text [not null]
  file_path text [not null]
  issued_on date
  expires_on date
  size_bytes bigint
  notes text
  created_at timestamptz [not null, note: 'now()']

  Note: 'Insurance, inspection certificates.'
}

Table equipment_inspections {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  equipment_id uuid [not null, ref: > equipment.id]
  employee_id uuid [ref: > employees.id]
  inspection_type text [not null]
  status inspection_status [not null]
  inspected_at timestamptz [not null]
  engine_hours "numeric(12,2)"
  notes text
  job_id uuid [ref: > jobs.id]
  mileage "numeric(12,2)"
  signed_at timestamptz
  created_at timestamptz [not null, note: 'now()']

  Note: 'Daily and annual checks.'
}

Table inspection_items {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  inspection_id uuid [not null, ref: > equipment_inspections.id]
  label text [not null]
  result text [not null]
  photo_path text
  sort_order integer [not null]
  item_code text
  notes text
  created_at timestamptz [not null, note: 'now()']

  Note: 'Checklist lines.'
}

Table maintenance_work_orders {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  equipment_id uuid [not null, ref: > equipment.id]
  work_order_number text [not null]
  status maintenance_status [not null]
  priority maintenance_priority [not null]
  title text [not null]
  description text
  scheduled_start timestamptz
  scheduled_end timestamptz
  completed_at timestamptz
  total_cost "numeric(12,2)"
  reported_by_employee_id uuid [ref: > employees.id]
  assigned_to_employee_id uuid [ref: > employees.id]
  opened_at timestamptz [not null]
  started_at timestamptz
  odometer_at_service "numeric(12,2)"
  engine_hours_at_service "numeric(12,2)"
  labor_hours "numeric(8,2)"
  parts_cost "numeric(12,2)"
  outside_service_cost "numeric(12,2)"
  vendor_name text
  resolution_notes text
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Repairs and shop time. Creates a reservation.'
}

Table maintenance_parts {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  work_order_id uuid [not null, ref: > maintenance_work_orders.id]
  part_number text
  description text [not null]
  quantity "numeric(12,3)" [not null]
  unit_cost "numeric(12,2)"
  vendor_name text
  created_at timestamptz [not null, note: 'now()']

  Note: 'Parts used on a work order.'
}

// ── Crew ────────────────────────────────────────────────────────

Table employees {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  branch_id uuid [ref: > branches.id]
  user_id uuid [ref: > app_users.id, note: 'null if no login']
  employee_number text
  first_name text [not null]
  last_name text [not null]
  preferred_name text
  email text
  phone text [note: 'E.164']
  status employee_status [not null]
  is_operator boolean [not null]
  is_mechanic boolean [not null]
  hire_date date
  cdl_class text
  cdl_expires_on date
  medical_cert_expires_on date
  job_title text [note: 'e.g. \'Lead operator\'']
  is_dispatcher boolean [not null]
  termination_date date
  notes text
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, id) [unique, note: 'target of composite tenant FKs']
    (company_id, employee_number) [unique]
    (company_id, last_name, first_name)
    (company_id, user_id)
  }

  Note: 'Operators, mechanics, dispatchers. user_id (login link) is never writable from the API.'
}

Table employee_private {
  employee_id uuid [pk, ref: > employees.id]
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  cdl_number text
  date_of_birth date
  home_address text
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Restricted: owner, admin and the employee only.'
}

Table employee_emergency_contacts {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  employee_id uuid [not null, ref: > employees.id]
  name text [not null]
  relationship text
  phone text [not null]
  sort_order integer [not null]

  Note: 'Restricted like employee_private.'
}

Table employee_certifications {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  employee_id uuid [not null, ref: > employees.id]
  certification_type text [not null]
  certification_number text
  issued_on date
  expires_on date
  file_path text
  issuing_authority text
  notes text
  created_at timestamptz [not null, note: 'now()']

  Note: 'CDL, medical certificate, other licences.'
}

Table employee_time_off {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  employee_id uuid [not null, ref: > employees.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status time_off_status [not null]
  reason text
  approved_by uuid [ref: > app_users.id]
  created_at timestamptz [not null, note: 'now()']

  Note: 'Approved leave creates a reservation.'
}

Table employee_time_entries {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  employee_id uuid [not null, ref: > employees.id]
  job_id uuid [ref: > jobs.id]
  clock_in timestamptz [not null]
  clock_out timestamptz
  break_minutes integer [not null]
  regular_hours "numeric(8,2)"
  overtime_hours "numeric(8,2)"
  notes text
  approved_by uuid [ref: > app_users.id]
  approved_at timestamptz
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  indexes {
    (company_id, employee_id, clock_in)
    (job_id)
  }

  Note: 'Clock in and out, per job or per day. Feeds payroll exports.'
}

// ── Tickets and billing ─────────────────────────────────────────

Table rate_cards {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  customer_id uuid [ref: > customers.id, note: 'null = company default']
  name text [not null]
  effective_from date
  effective_to date
  is_default boolean [not null]
  description text
  is_active boolean [not null, note: 'default true; soft delete']
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Company default plus customer overrides.'
}

Table rate_card_items {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  rate_card_id uuid [not null, ref: > rate_cards.id]
  item_code text [not null]
  description text [not null]
  pricing_model pricing_model [not null]
  unit text [not null, note: '\'hour\', \'foot\', \'job\'']
  unit_price "numeric(12,2)" [not null]
  minimum_quantity "numeric(12,3)" [note: '4.000 hours']
  equipment_class text [note: '\'34M\'']
  overtime_after_hours "numeric(6,2)"
  sort_order integer [not null]
  created_at timestamptz [not null, note: 'now()']

  Note: '\'34m boom pump $250/h, 4 h min\', \'Extra hose $2/ft\'.'
}

Table work_tickets {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, unique, ref: > jobs.id]
  ticket_number text [not null]
  status ticket_status [not null]
  operator_id uuid [ref: > employees.id]
  equipment_id uuid [ref: > equipment.id]
  arrived_at timestamptz [note: 'actual, UTC']
  pumping_started_at timestamptz
  pumping_ended_at timestamptz
  departed_at timestamptz
  billed_hours "numeric(8,2)"
  pumped_yards "numeric(10,2)"
  delay_minutes integer
  overran_next_job boolean [not null, note: 'late-finish flag']
  customer_signer_name text
  signature_path text
  signature_sha256 text [note: 'tamper evidence']
  signed_at timestamptz
  submitted_at timestamptz
  approved_at timestamptz
  approved_by uuid [ref: > app_users.id]
  version integer [not null]
  setup_started_at timestamptz
  cleanup_ended_at timestamptz
  travel_minutes integer [note: 'billed, after office adjustment']
  prep_minutes integer [note: 'billed']
  pump_minutes integer [note: 'billed']
  cleanup_minutes integer [note: 'billed']
  travel_miles "numeric(10,2)"
  concrete_temperature_f "numeric(5,1)" [note: 'degrees F']
  weather_notes text
  washout_location text
  delay_reason text
  operator_notes text
  customer_notes text
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'What really happened. Read-only after approval.'
}

Table work_ticket_line_items {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  work_ticket_id uuid [not null, ref: > work_tickets.id]
  rate_card_item_id uuid [ref: > rate_card_items.id, note: 'which rate was used']
  description text [not null]
  quantity "numeric(12,3)" [not null]
  unit text
  unit_price "numeric(12,2)" [not null]
  amount "numeric(12,2)" [not null]
  sort_order integer [not null]
  item_code text
  created_at timestamptz [not null, note: 'now()']

  Note: 'Prices frozen at approval.'
}

Table invoices {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  customer_id uuid [not null, ref: > customers.id]
  invoice_number text [note: 'given when sent']
  status invoice_status [not null]
  invoice_date date [not null]
  due_date date
  bill_to_name text [not null, note: 'snapshot']
  bill_to_address text [not null, note: 'snapshot']
  bill_to_email text [note: 'snapshot']
  subtotal "numeric(12,2)" [not null]
  tax_rate "numeric(7,4)" [not null]
  tax_amount "numeric(12,2)" [not null]
  total_amount "numeric(12,2)" [not null]
  amount_paid "numeric(12,2)" [not null]
  balance_due "numeric(12,2)" [not null]
  sent_at timestamptz
  voided_at timestamptz
  purchase_order_number text
  discount_amount "numeric(12,2)" [not null]
  terms text
  notes text
  paid_at timestamptz
  created_by uuid [ref: > app_users.id]
  created_at timestamptz [not null, note: 'now()']
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Bill-to details are copied at issue so later customer edits never change it.'
}

Table invoice_items {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  invoice_id uuid [not null, ref: > invoices.id]
  job_id uuid [ref: > jobs.id]
  work_ticket_id uuid [ref: > work_tickets.id]
  description text [not null]
  quantity "numeric(12,3)" [not null]
  unit_price "numeric(12,2)" [not null]
  amount "numeric(12,2)" [not null]
  sort_order integer [not null]
  item_code text
  unit text
  tax_rate "numeric(7,4)" [not null]
  created_at timestamptz [not null, note: 'now()']

  Note: 'Copied from approved ticket lines.'
}

Table payments {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  customer_id uuid [not null, ref: > customers.id]
  status payment_status [not null]
  method payment_method [not null]
  received_on date [not null]
  amount "numeric(12,2)" [not null]
  reference text
  processor text
  processor_payment_id text [unique]
  memo text
  received_by uuid [ref: > app_users.id]
  updated_at timestamptz [not null, note: 'now(), trigger']
  created_at timestamptz [not null, note: 'now()']

  Note: 'Money received.'
}

Table payment_allocations {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  payment_id uuid [not null, ref: > payments.id]
  invoice_id uuid [not null, ref: > invoices.id]
  amount "numeric(12,2)" [not null]
  created_at timestamptz [not null, note: 'now()']

  Note: 'One payment split across invoices.'
}

// ── Lists and settings ──────────────────────────────────────────

Table pour_types {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  name text [not null]
  is_favorite boolean [not null]
  sort_order integer [not null]
  is_active boolean [not null, note: 'default true; soft delete']

  Note: 'Footings, house slab, ICF wall...'
}

Table tags {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  name text [not null]
  color tag_color [not null]
  applies_to "text[]" [not null, note: 'e.g. {\'customer\',\'job\'}']
  is_active boolean [not null, note: 'default true; soft delete']

  Note: 'Coloured labels.'
}

Table customer_tags {
  customer_id uuid [ref: > customers.id]
  tag_id uuid [ref: > tags.id]
  company_id uuid [not null, ref: > companies.id, note: 'tenant']

  indexes {
    (customer_id, tag_id) [pk]
  }

  Note: 'Join table.'
}

Table job_tags {
  job_id uuid [ref: > jobs.id]
  tag_id uuid [ref: > tags.id]
  company_id uuid [not null, ref: > companies.id, note: 'tenant']

  indexes {
    (job_id, tag_id) [pk]
  }

  Note: 'Join table.'
}

Table contact_tags {
  contact_id uuid [ref: > contacts.id]
  tag_id uuid [ref: > tags.id]
  company_id uuid [not null, ref: > companies.id, note: 'tenant']

  indexes {
    (contact_id, tag_id) [pk]
  }

  Note: 'Join table.'
}

Table notification_rules {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  audience rule_audience [not null]
  event_type text [not null]
  channel notification_channel [not null]
  offset_minutes integer [note: '-60 = 60 min before arrival']
  recipients text
  is_enabled boolean [not null]
  updated_at timestamptz [not null, note: 'now(), trigger']

  Note: 'Which message goes out when.'
}

// ── Platform ────────────────────────────────────────────────────

Table activity_log {
  id uuid [pk, note: 'gen_random_uuid(); order by created_at (Postgres 17 has no uuidv7)']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  actor_id uuid [ref: > app_users.id]
  entity_type text [not null]
  entity_id uuid [not null]
  action text [not null]
  changes jsonb [note: '{field: [old, new]}']
  summary text [note: 'one readable line for the Logs screen']
  created_at timestamptz [not null, note: 'now()']

  indexes {
    (company_id, created_at)
    (company_id, entity_type, entity_id, created_at)
    (company_id, actor_id, created_at)
  }

  Note: 'The Logs screen. Append-only, partitioned by month.'
}

Table notifications {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  user_id uuid [not null, ref: > app_users.id]
  type text [not null]
  title text [not null]
  body text
  entity_type text
  entity_id uuid
  read_at timestamptz
  created_at timestamptz [not null, note: 'now()']

  Note: 'In-app alerts per user.'
}

Table notification_deliveries {
  id uuid [pk, note: 'uuidv7']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  event_id uuid [not null]
  job_id uuid [ref: > jobs.id]
  job_version integer [note: 'job.version when queued; stale = skipped']
  contact_id uuid [ref: > contacts.id]
  recipient text [not null, note: 'E.164 or email']
  channel notification_channel [not null]
  template text [not null]
  status delivery_status [not null]
  provider_message_id text
  error text
  sent_at timestamptz
  delivered_at timestamptz
  created_at timestamptz [not null, note: 'now()']

  indexes {
    (event_id, recipient, channel) [unique]
  }

  Note: 'Every text and email. Unique per event, recipient and channel.'
}

Table job_alerts {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  job_id uuid [not null, ref: > jobs.id]
  rule_key text [not null]
  fired_at timestamptz [not null]

  indexes {
    (job_id, rule_key) [unique]
  }

  Note: 'Office alerts already fired.'
}

Table sms_opt_outs {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  phone text [not null, note: 'E.164']
  opted_out_at timestamptz [not null]

  Note: 'STOP replies.'
}

Table idempotency_keys {
  key uuid [pk]
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  action text [not null]
  result jsonb
  created_at timestamptz [not null, note: 'now()']

  Note: 'A double-click books once. Purged after 48 h.'
}

Table import_batches {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  source text [not null]
  entity_type text [not null]
  status text [not null]
  row_count integer
  error_count integer
  created_by uuid [ref: > app_users.id]
  created_at timestamptz [not null, note: 'now()']

  Note: 'CreteSuite imports.'
}

Table integration_connections {
  id uuid [pk, note: 'gen_random_uuid()']
  company_id uuid [not null, ref: > companies.id, note: 'tenant']
  provider text [not null]
  status text [not null]
  vault_secret_id uuid [note: 'Supabase Vault']
  connected_at timestamptz

  Note: 'QuickBooks, Stripe (Phase 2). Secrets in Vault.'
}

